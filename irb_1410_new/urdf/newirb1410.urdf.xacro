<?xml version="1.0"?>
<robot name="irb1410_1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- MATERIALS -->
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="green"><color rgba="0 1 0 1"/></material>
  <material name="yellow"><color rgba="1 1 0 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>

  <!--############### WORLD LINK ###############-->
  <link name="world"/>

  <!--############### ROBOT-FIXED-BASE LINK ###############-->
  <link name="robot_base" >
    <visual>    
        <geometry>
            <box size="0.82 0.86 0.235"/>
        </geometry>
        <origin xyz="0 0 0.1175" rpy="0 0 0" />
        <material name="red"/>
    </visual>
        
    <collision>
        <visual>    
            <geometry>
                <box size="0.82 0.86 0.235"/>
            </geometry>
        <origin xyz="0 0 0.1175" rpy="0 0 0" />
        <material name="red"/>
        </visual>
    </collision>
  </link>

  <!--############### ROBOT-JOINT-1 BASE LINK ###############-->
  <link name="link_1" >
        <visual>    
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/Base.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.15 0 1" rpy="0 0 1.57" />
            <material name="green"/>
        </visual>

        <collision>
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/Base.stl" 
                      scale="0.001 0.001 0.01"/>
            </geometry>
            <origin xyz="0.15 0 1" rpy="0 0 1.57" />
        </collision>
    </link>

    <!--############### ROBOT-JOINT-2 LINK ###############-->
    <link name="link_2" >
        <visual>    
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/Arm_1.stl" 
                      scale="0.00085 0.0007 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 1.57" />
            <material name="blue"/>
        </visual>

        <collision>
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/Arm_1.stl" 
                      scale="0.00085 0.0007 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 1.57" />
        </collision>
    </link>


    <!--   ############### ROBOT ARM 3 LINK ###############  -->
    <link name="link_3" >
        <visual>    
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/Arm_2.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0.11" rpy="0 0 1.57" />
            <material name="yellow"/>
        </visual>

        <collision>
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/Arm_2.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0.11" rpy="0 0 1.57" />
        </collision>
    </link>

    <!--   ############### ROBOT LINK 4 ###############  -->
    <link name="link_4" >
        <visual>    
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/Wrist.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0.004 -0.01" rpy="0 0 1.57" />
            <material name="orange"/>
        </visual>

        <collision>
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/Wrist.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0.004 -0.01" rpy="0 0 1.57" />
        </collision>
    </link>

    <!--   ############### ROBOT LINK 5  ############### -->
    <link name="link_5" >
        <visual>    
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/End_wrist.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="-0.713 0 0" rpy="0 0 1.57" />
            <material name="yellow"/>
        </visual>

        <collision>
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/End_wrist.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="-0.713 0 0" rpy="0 0 1.57" />
        </collision>
    </link>

    <!--   ############### ROBOT LINK 6 ###############  -->
    <link name="link_6" >
        <visual>    
            <geometry>
                <mesh filename="package://irb_1410_new/meshes/END.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="-0.798 0 0" rpy="0 0 1.57" />
            <material name="green"/>
        </visual>

        <collision>
             <geometry>
                <mesh filename="package://irb_1410_new/meshes/END.stl" 
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="-0.798 0 0" rpy="0 0 1.57" />
        </collision>
    </link>

  <!-- WORDL-ROBOT-FIXED-BASED JOINT-->
  <joint name="world_to_base" type="fixed">
        <parent link="world"/>
        <child link="robot_base"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ROBOT-LINK-1_-_ROBOT-FIXED JOINT-->
   <joint name="=joint1" type="revolute">
        <parent link="robot_base"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.235" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-2.96706" upper="2.96706" effort="10" velocity="1"/>
    </joint>
    
  <!-- ROBOT-LINK-2_-_ROBOT-LINK-1 JOINT-->
   <joint name="joint2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0.150 0 0.475" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.96706" upper="2.96706" effort="10" velocity="1"/>
    </joint>
    
    <!-- ROBOT-LINK-3_-_ROBOT-LINK-2 JOINT-->
    <joint name="joint3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 0.6" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.96706" upper="2.96706" effort="10" velocity="1"/>
    </joint>

    <!-- ROBOT-LINK-4_-_ROBOT-LINK-3 JOINT-->
    <joint name="joint4" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 0.120" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-2.96706" upper="2.96706" effort="10" velocity="1"/>
    </joint>

    <!-- ROBOT-LINK-5_-_ROBOT-LINK-4 JOINT-->
    <joint name="joint5" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0.720 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.96706" upper="2.96706" effort="10" velocity="1"/>
    </joint>

    <!-- ROBOT-LINK-6_-_ROBOT-LINK-5 JOINT-->
    <joint name="joint6" type="revolute">
        <parent link="link_5"/>
        <child link="link_6"/>
        <origin xyz="0.085 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-2.96706" upper="2.96706" effort="10" velocity="1"/>
    </joint>
 
</robot>